# Website agent brains. Set these in the host environment, not in git.
# One shared OpenAI-compatible key is enough. A per-agent key overrides it.

AGENT_AI_API_KEY=
AGENT_AI_BASE_URL=https://api.openai.com/v1
AGENT_AI_MODEL=gpt-4o-mini

GENNIFER_AI_API_KEY=
GENNIFER_AI_BASE_URL=
GENNIFER_AI_MODEL=
TWAIN_AI_API_KEY=
TWAIN_AI_BASE_URL=
TWAIN_AI_MODEL=
CODY_AI_API_KEY=
CODY_AI_BASE_URL=
CODY_AI_MODEL=
ART_AI_API_KEY=
ART_AI_BASE_URL=
ART_AI_MODEL=

# If the base URL contains anthropic.com, the call uses the Anthropic Messages API.
# Other values use POST {base}/chat/completions with a Bearer token.
# Gemini's OpenAI-compatible base is https://generativelanguage.googleapis.com/v1beta/openai

# Persistence for each agent's notes. Not an AI key.
AZURE_STORAGE_CONNECTION_STRING=

# Agent chat (Preview only for now; Production keeps CHAT_ENABLED=false or unset).
# Chat code never uses AZURE_STORAGE_CONNECTION_STRING.
CHAT_ENABLED=
ANTHROPIC_API_KEY=
CHAT_ROUTER_MODEL=claude-haiku-5-5
CHAT_ANSWER_MODEL=claude-sonnet-5-5
# Full SAS URLs (https://<account>.blob.core.windows.net/<container>?<sas>):
# BRAINS_READ_SAS is read+list on the brains container only.
# CHAT_STORAGE_SAS is read/write/list/delete on the NEW chat container only.
BRAINS_READ_SAS=
CHAT_STORAGE_SAS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CHAT_DAILY_TOKEN_BUDGET=
CHAT_IP_SALT=
